# Local environment and secrets
.env
.env.*
!.env.example

# Runtime output
**/writable/cache/*
**/writable/debugbar/*
**/writable/logs/*
**/writable/session/*
**/writable/uploads/*
**/test-results/*
**/playwright-report/*

# Dependencies and generated frontend output
**/vendor/
**/node_modules/
**/dist/
**/coverage/

# IDE and operating system files
.vscode/
.idea/
Thumbs.db
.DS_Store

# Local database and logs
*.sqlite
*.sqlite3
*.db
*.log
*.sql

# M3.4 sandbox/session/acceptance outputs must not be committed
backend/writable/m34b/
backend/writable/m34d/

# M9.3: never ship Office lock files (especially under frontend/public).
**/~$*.xlsx
**/~[0-9]*$*.xlsx
**/__pycache__/
*.pyc
