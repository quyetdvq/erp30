{
  "name": "vue-project",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint . --no-cache",
    "format": "prettier --write --experimental-cli src/",
    "format:check": "prettier --check src/ e2e/",
    "openapi:lint": "redocly lint ../contracts/openapi/openapi.yaml --config ../contracts/openapi/redocly.yaml",
    "openapi:generate": "openapi-ts -f openapi-ts.config.ts",
    "openapi:generate:check": "pnpm run openapi:generate && node scripts/check-openapi-generated.mjs"
  },
  "dependencies": {
    "@vueuse/core": "14.4.0",
    "axios": "1.20.0",
    "bootstrap": "5.3.8",
    "chart.js": "4.5.1",
    "dayjs": "1.11.23",
    "naive-ui": "2.45.3",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-chartjs": "5.3.4",
    "vue-i18n": "11.4.12",
    "vue-router": "^5.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "^1.63.0",
    "@redocly/cli": "2.53.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
