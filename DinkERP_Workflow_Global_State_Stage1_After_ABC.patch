+    /**
+     * Derive the evaluation state from a persisted target for *any* resource
+     * with a configured lifecycle, not merely API-010. A caller-supplied ID
+     * must not override the persisted current state. In a transition the
+     * trusted adapter also supplies the From-State ID for cross-checking.
+     *
+     * A resource without lifecycle configuration keeps its legacy path until
+     * the lifecycle/data rollout is completed; such resources cannot create
+     * new state-scoped policies (assertPolicyState rejects them).
+     *
+     * @param array<string,mixed>|null $persistedTarget
+     * @param array<string,mixed> $input
+     */
+    public function stateForAuthorization(
+        string $type,
+        ?array $persistedTarget,
+        ?int $explicitStateId,
+        ?array $trustedCatalogRow = null,
+        string $action = '',
+        array $input = [],
+    ): ?int
+    {
+        // AuthorizationService already loaded the canonical Resource row.
+        // Reuse it; otherwise per-row List checks would requery resources.
+        if ($trustedCatalogRow !== null) {
+            $this->resourceCache[$type] = $trustedCatalogRow;
+        }
+        if ($type === 'lifecycle') {
+            $this->lifecycleId($type);
+            if ($persistedTarget === null) {
+                return null;
+            }
+            $canonical = $this->persistedStateId($type, $persistedTarget);
+            if ($explicitStateId !== null && $explicitStateId !== $canonical) {
+                throw new DomainException(self::ERROR_STATE_CONTEXT_MISMATCH, ['resource' => $type]);
+            }
+            return $canonical;
+        }
+
+        if ($this->lifecycleId($type) === null) {
+            return $explicitStateId;
+        }
+
+        // Shared lifecycle rules: creation must use the configured Initial
+        // State; ordinary edits must not become an alternative setstate API.
+        // Existing master services without a lifecycle remain on the legacy
+        // path until their data has been migrated and validated.
+        if ($persistedTarget === null && $action === 'create') {
+            $initial = $this->initialCode($type);
+            $requested = $input['status'] ?? null;
+            if (! is_string($requested) || strtoupper(trim($requested)) !== $initial) {
+                throw new DomainException(self::ERROR_INITIAL_STATE_REQUIRED, ['resource' => $type, 'initial' => $initial]);
+            }
+        }
+        if ($persistedTarget !== null) {
+            $canonical = $this->persistedStateId($type, $persistedTarget);
+            if ($explicitStateId !== null && $canonical !== $explicitStateId) {
+                throw new DomainException(self::ERROR_STATE_CONTEXT_MISMATCH, ['resource' => $type]);
+            }
+            if ($action === 'edit' && array_key_exists('status', $input)) {
+                throw new DomainException(self::ERROR_TRANSITION_REQUIRED, ['resource' => $type]);
+            }
+            if ($action === 'setstate') {
+                // Only the LifecycleService path provides an authoritative
+                // From-State ID. Standalone legacy setState methods must
+                // acquire a dedicated adapter before lifecycle activation.
+                if ($explicitStateId === null) {
+                    throw new DomainException(self::ERROR_TRANSITION_REQUIRED, ['resource' => $type]);
+                }
+                if (array_key_exists('status', $input)) {
+                    $this->stateIdForCode($type, $input['status']);
+                }
+            }
+            return $canonical;
+        }
