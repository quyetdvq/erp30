diff --git a/frontend/src/features/history/components/BusinessHistoryPanel.vue b/frontend/src/features/history/components/BusinessHistoryPanel.vue
index 57e2b5a..ff1a019 100644
--- a/frontend/src/features/history/components/BusinessHistoryPanel.vue
+++ b/frontend/src/features/history/components/BusinessHistoryPanel.vue
@@ -3,11 +3,12 @@ import { computed, onBeforeUnmount, ref, watch } from 'vue'
 import { useI18n } from 'vue-i18n'
