+                'code' => 'WF007-' . $status . '-' . uniqid(),
+                'product_type' => 'STANDARD', 'product_name' => $status . ' item',
+                'status' => $status, 'created_at' => '2026-10-06 00:00:00',
+            ]));
+        }
+        $this->policy('product', $f, $this->stateId('INACTIVE'), 'view', 'ABSOLUTE_DENY');
