+        $this->assertDomainCode(fn () => $role->describeList([$child]), ProductRoleService::ERROR_INVALID_ROLE);
+
+        $combo = ['id' => 90003, 'product_type' => 'COMBO', 'product_name' => 'Combo', 'status' => 'ACTIVE'];
+        $this->assertDomainCode(
