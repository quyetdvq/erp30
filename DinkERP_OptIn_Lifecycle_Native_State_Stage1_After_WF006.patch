diff --git a/backend/tests/unit/P1OptInLifecycleNativeStateRegistryTest.php b/backend/tests/unit/P1OptInLifecycleNativeStateRegistryTest.php
new file mode 100644
index 0000000..084c837
--- /dev/null
+++ b/backend/tests/unit/P1OptInLifecycleNativeStateRegistryTest.php
@@ -0,0 +1,46 @@
+<?php
+
+declare(strict_types=1);
+
+use App\Services\ResourceNativeStateRegistry;
+use PHPUnit\Framework\TestCase;
+
+/** @internal */
+final class P1OptInLifecycleNativeStateRegistryTest extends TestCase
+{
+    public function testNativeOnlyResourcesCannotBeAttachedToLifecycle(): void
+    {
+        foreach ([
+            'authorization_group', 'authorization_log', 'display_setting',
+            'employee_assignment', 'import_job', 'lifecycle', 'policy',
+            'user', 'workflow_state', 'resource',
+        ] as $type) {
+            self::assertTrue(ResourceNativeStateRegistry::forbidsLifecycle($type), $type);
+        }
+        self::assertCount(10, ResourceNativeStateRegistry::nativeOnlyTypes());
+        self::assertFalse(ResourceNativeStateRegistry::forbidsLifecycle('province'));
+        self::assertFalse(ResourceNativeStateRegistry::forbidsLifecycle('product'));
+    }
+
+    public function testNativeAndStatelessCatalogPreservesPolicyStateSemantics(): void
+    {
+        self::assertSame([], ResourceNativeStateRegistry::codes('authorization_log'));
+        self::assertSame([], ResourceNativeStateRegistry::codes('display_setting'));
+        self::assertSame(['ACTIVE', 'INACTIVE'], ResourceNativeStateRegistry::codes('policy'));
+        self::assertSame(['ACTIVE', 'INACTIVE'], ResourceNativeStateRegistry::codes('resource'));
+        self::assertSame(['ACTIVE', 'INACTIVE', 'CLOSED'], ResourceNativeStateRegistry::codes('province'));
+        self::assertContains('COMPLETED_WITH_ERRORS', ResourceNativeStateRegistry::codes('import_job'));
+    }
+
+    public function testNativeCatalogCoversEveryDeclaredCodeWithoutDuplicates(): void
+    {
+        $codes = ResourceNativeStateRegistry::allCodes();
+        self::assertContains('ACTIVE', $codes);
+        self::assertContains('INACTIVE', $codes);
+        self::assertContains('CLOSED', $codes);
+        self::assertSame(count($codes), count(array_unique($codes)));
+        $sorted = $codes;
+        sort($sorted);
+        self::assertSame($sorted, $codes);
+    }
+}
