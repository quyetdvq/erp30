+        'authorization_group' => ['ACTIVE', 'INACTIVE'],
+        'authorization_log' => [],
+        'display_setting' => [],
+        'employee_assignment' => ['ACTIVE', 'INACTIVE'],
+        'import_job' => ['PENDING', 'PROCESSING', 'COMPLETED', 'COMPLETED_WITH_ERRORS', 'FAILED'],
+        'lifecycle' => ['ACTIVE', 'INACTIVE'],
+        'policy' => ['ACTIVE', 'INACTIVE'],
+        'user' => ['ACTIVE', 'INACTIVE', 'LOCKED', 'SUSPENDED', 'BANNED', 'DISABLED'],
+        'workflow_state' => ['ACTIVE', 'INACTIVE'],
+        'resource' => ['ACTIVE', 'INACTIVE'],
+    ];
+
+    /** @var array<string, list<string>> */
+    private const OPT_IN_NATIVE = [
+        'province' => ['ACTIVE', 'INACTIVE', 'CLOSED'],
+        'ward' => ['ACTIVE', 'INACTIVE', 'CLOSED'],
+        'organization' => ['ACTIVE', 'INACTIVE', 'CLOSED'],
+        'contact' => ['ACTIVE', 'INACTIVE', 'CLOSED'],
+        'department' => ['ACTIVE', 'INACTIVE', 'CLOSED'],
+        'position' => ['ACTIVE', 'INACTIVE', 'CLOSED'],
+        'employee' => ['ACTIVE', 'INACTIVE'],
+        'product_group' => ['ACTIVE', 'INACTIVE'],
+        'product_uom' => ['ACTIVE', 'INACTIVE'],
+        'product' => ['ACTIVE', 'INACTIVE'],
+        'price_list' => ['ACTIVE', 'INACTIVE'],
+    ];
+
+    /** @return list<string> */
+    public static function nativeOnlyTypes(): array
+    {
+        return array_keys(self::NATIVE_ONLY);
+    }
+
+    public static function forbidsLifecycle(string $type): bool
+    {
+        return array_key_exists(strtolower(trim($type)), self::NATIVE_ONLY);
+    }
+
+    /** @return list<string> */
+    public static function codes(string $type): array
+    {
+        $type = strtolower(trim($type));
+
+        return self::NATIVE_ONLY[$type] ?? self::OPT_IN_NATIVE[$type] ?? [];
+    }
+
+    /** @return list<string> */
+    public static function allCodes(): array
+    {
+        $codes = [];
+        foreach (self::NATIVE_ONLY + self::OPT_IN_NATIVE as $allowed) {
+            foreach ($allowed as $code) {
+                $codes[$code] = true;
+            }
+        }
+        $result = array_keys($codes);
+        sort($result);
+
+        return $result;
+    }
+}
